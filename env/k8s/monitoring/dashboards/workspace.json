        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{namespace=\"schema-workspace\", container=\"server\", status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_requests_total{namespace=\"schema-workspace\", container=\"server\"}[5m])), 1e-9)",
          "legendFormat": "5xx",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
