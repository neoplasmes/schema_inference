meta {
  name: Cached manifest after delete
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v2/schemas/{{schemaId}}/revisions/{{nextRevision}}/manifest
  body: none
  auth: inherit
}

script:pre-request {
  if (String(bru.getEnvVar("cacheChecks")) !== "true") {
    bru.runner.skipRequest();
  }
}

tests {
  test("deleted schema manifest is not found", function () {
    expect(res.getStatus()).to.equal(404);
  });

  test("purged entry is not a cache hit", function () {
    expect(String(res.getHeader("cache-status") || "").toLowerCase()).to.not.contain("hit");
  });
}
