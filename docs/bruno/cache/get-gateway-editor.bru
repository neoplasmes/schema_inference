meta {
  name: Gateway serves editor entry
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/editor/remoteEntry.js
  body: none
  auth: none
}

script:pre-request {
  if (String(bru.getEnvVar("cacheChecks")) !== "true") {
    bru.runner.skipRequest();
  }
}

tests {
  test("editor answers", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
