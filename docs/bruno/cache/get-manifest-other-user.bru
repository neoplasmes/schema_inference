meta {
  name: Cached manifest hidden from another user
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v2/schemas/{{schemaId}}/revisions/{{nextRevision}}/manifest
  body: none
  auth: none
}

script:pre-request {
  if (String(bru.getEnvVar("cacheChecks")) !== "true") {
    bru.runner.skipRequest();

    return;
  }

  const { fetchToken } = require("./lib/token.js");

  req.setHeader("Authorization", "Bearer " + (await fetchToken(bru, "other")));
}

tests {
  test("cached revision is not served to a non-owner", function () {
    expect(res.getStatus()).to.equal(404);
    expect(String(res.getHeader("cache-status") || "").toLowerCase()).to.not.contain("hit");
  });
}
