meta {
  name: Gateway serves root
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/
  body: none
  auth: none
}

script:pre-request {
  if (String(bru.getEnvVar("cacheChecks")) !== "true") {
    bru.runner.skipRequest();
  }
}

tests {
  test("root answers", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
