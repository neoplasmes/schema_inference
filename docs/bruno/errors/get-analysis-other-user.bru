get {
  url: {{baseUrl}}/api/v2/analyses/{{analysisId}}
  body: none
  auth: none
}

script:pre-request {
  const { fetchToken } = require("./lib/token.js");

  req.setHeader("Authorization", "Bearer " + (await fetchToken(bru, "other")));
}

tests {
  test("hides the analysis of an owner", function () {
    expect(res.getStatus()).to.equal(404);
  });
}
