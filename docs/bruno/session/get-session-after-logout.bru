meta {
  name: Session after logout
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v2/session
  body: none
  auth: none
}

script:pre-request {
  req.setHeader("Authorization", "Bearer " + bru.getVar("logoutToken"));
}

tests {
  test("token is refused immediately", function () {
    expect(res.getStatus()).to.equal(401);
  });
}
