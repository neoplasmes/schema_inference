meta {
  name: Session before logout
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v2/session
  body: none
  auth: none
}

script:pre-request {
  if (String(bru.getEnvVar("cacheChecks")) !== "true") {
    bru.runner.skipRequest();

    return;
  }

  const { fetchToken } = require("./lib/token.js");
  const token = await fetchToken(bru, "primary");

  bru.setVar("logoutRevocationToken", token);
  req.setHeader("Authorization", "Bearer " + token);
}

tests {
  test("fresh token is accepted", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
