meta {
  name: Session after logout is refused without retry
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v2/session
  body: none
  auth: none
}

script:pre-request {
  if (String(bru.getEnvVar("cacheChecks")) !== "true") {
    bru.runner.skipRequest();

    return;
  }

  req.setHeader("Authorization", "Bearer " + bru.getVar("logoutRevocationToken"));
}

tests {
  test("token is refused on the very next request", function () {
    expect(res.getStatus()).to.equal(401);
  });
}
