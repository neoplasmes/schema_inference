meta {
  name: Reactivate the user at the identity provider
  type: http
  seq: 5
}

post {
  url: {{idpUrl}}/v2/users/{{revocationSubject}}/reactivate
  body: json
  auth: none
}

headers {
  Host: {{idpHost}}
  Authorization: Bearer {{process.env.ZITADEL_ADMIN_PAT}}
}

body:json {
  {}
}

script:pre-request {
  if (String(bru.getEnvVar("cacheChecks")) !== "true") {
    bru.runner.skipRequest();
  }
}

tests {
  test("identity provider reactivates the user", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
