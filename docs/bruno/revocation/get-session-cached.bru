meta {
  name: Session with the same token again
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v2/session
  body: none
  auth: none
}

script:pre-request {
  if (String(bru.getEnvVar("cacheChecks")) !== "true") {
    bru.runner.skipRequest();

    return;
  }

  req.setHeader("Authorization", "Bearer " + bru.getVar("revocationToken"));
}

tests {
  test("cached introspection still accepts the token", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
