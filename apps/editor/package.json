{
    "name": "schema-editor",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "tsx ./node_modules/webpack-cli/bin/cli.js serve --config webpack.config.ts --mode development",
        "build": "tsx ./node_modules/webpack-cli/bin/cli.js --config webpack.config.ts --mode production",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "lint": "eslint src scripts playground visual webpack.config.ts && tsx scripts/check-architecture.ts",
        "playground": "pnpm dev",
        "visual": "tsx visual/run.ts",
        "perf": "tsx visual/perf.ts",
        "sync-tokens": "tsx scripts/sync-tokens.ts"
    },
    "dependencies": {
        "pixi.js": "8.11.0",
        "react": "19.1.0",
        "react-dom": "19.1.0"
    },
    "devDependencies": {
        "@eslint/js": "9.31.0",
        "@module-federation/enhanced": "0.17.0",
        "@rspack/core": "1.4.8",
        "@playwright/test": "1.54.1",
        "@types/node": "22.16.4",
        "@types/react": "19.1.8",
        "@types/react-dom": "19.1.6",
        "css-loader": "7.1.2",
        "eslint": "9.31.0",
        "eslint-plugin-react-hooks": "5.2.0",
        "globals": "16.3.0",
        "html-webpack-plugin": "5.6.3",
        "style-loader": "4.0.0",
        "ts-loader": "9.5.2",
        "tsx": "4.20.3",
        "typescript": "5.8.3",
        "typescript-eslint": "8.37.0",
        "vitest": "3.2.4",
        "webpack": "5.100.2",
        "webpack-cli": "6.0.1",
        "webpack-dev-server": "5.2.2"
    }
}
