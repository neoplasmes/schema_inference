{
    "$schema": "https://biomejs.dev/schemas/2.2.6/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": true,
        "includes": [
            "**",
            "!**/node_modules",
            "!**/dist",
            "!**/build",
            "!**/.cache",
            "!**/@mf-types",
            "!**/coverage",
            "!**/test-results",
            "!**/playwright-report",
            "!**/visual/actual",
            "!**/visual/compare"
        ]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 90,
        "lineEnding": "lf",
        "expand": "always"
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "jsxQuoteStyle": "double",
            "quoteProperties": "asNeeded",
            "semicolons": "always",
            "trailingCommas": "es5",
            "arrowParentheses": "asNeeded",
            "bracketSpacing": true,
            "bracketSameLine": false,
            "attributePosition": "auto"
        }
    },
    "css": {
        "parser": {
            "cssModules": true
        },
        "formatter": {
            "quoteStyle": "single"
        }
    },
    "linter": {
        "enabled": false
    },
    "assist": {
        "enabled": false
    }
}
